%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d28e610806839a3308baf4b0124d8251, type: 3}
  m_Name: Ending
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: ""
    text: "Serangan terakhir menara hutan menghantam Flame Director. Sang pemimpin api pun tumbang."
    cg: {fileID: 0}
    backgroundColor: {r: 0.32, g: 0.08, b: 0.05, a: 1}
    shake: 1
  - speaker: ""
    text: "Satu per satu, monster api yang tersisa menyerah dan mundur."
    cg: {fileID: 0}
    backgroundColor: {r: 0.32, g: 0.08, b: 0.05, a: 1}
    shake: 0
  - speaker: ""
    text: "Api dan asap perlahan menghilang. Langit kembali cerah, dan seberkas cahaya menyinari The Wall."
    cg: {fileID: 0}
    backgroundColor: {r: 0.55, g: 0.42, b: 0.28, a: 1}
    shake: 0
  - speaker: "Taduh"
    text: "Kau berhasil... Terima kasih telah melindungi kami."
    cg: {fileID: 0}
    backgroundColor: {r: 0.72, g: 0.66, b: 0.45, a: 1}
    shake: 0
  - speaker: "Taduh"
    text: "Hutan ini selamat dari penggundulan. Para roh hutan tidak akan pernah melupakanmu."
    cg: {fileID: 0}
    backgroundColor: {r: 0.72, g: 0.66, b: 0.45, a: 1}
    shake: 0
  - speaker: ""
    text: "- TAMAT -"
    cg: {fileID: 0}
    backgroundColor: {r: 0.02, g: 0.02, b: 0.02, a: 1}
    shake: 0
  - speaker: ""
    text: "RimbaChromia\nGIMERSIA 2026\n\nTerima kasih telah bermain!"
    cg: {fileID: 0}
    backgroundColor: {r: 0.02, g: 0.02, b: 0.02, a: 1}
    shake: 0
