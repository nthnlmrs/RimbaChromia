%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d28e610806839a3308baf4b0124d8251, type: 3}
  m_Name: Ending
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: ""
    text: "The towers of the forest strike one final blow. The Flame Director falls."
    cg: {fileID: 0}
    backgroundColor: {r: 0.32, g: 0.08, b: 0.05, a: 1}
    shake: 1
  - speaker: ""
    text: "One by one, the remaining fire monsters surrender and retreat."
    cg: {fileID: 0}
    backgroundColor: {r: 0.32, g: 0.08, b: 0.05, a: 1}
    shake: 0
  - speaker: ""
    text: "The fire and smoke slowly fade away. The sky clears, and a beam of light shines upon The Wall."
    cg: {fileID: 0}
    backgroundColor: {r: 0.55, g: 0.42, b: 0.28, a: 1}
    shake: 0
  - speaker: "Taduh"
    text: "You did it... Thank you for protecting us."
    cg: {fileID: 0}
    backgroundColor: {r: 0.72, g: 0.66, b: 0.45, a: 1}
    shake: 0
  - speaker: "Taduh"
    text: "The forest is safe from deforestation. The forest spirits will never forget you."
    cg: {fileID: 0}
    backgroundColor: {r: 0.72, g: 0.66, b: 0.45, a: 1}
    shake: 0
  - speaker: ""
    text: "- THE END -"
    cg: {fileID: 0}
    backgroundColor: {r: 0.02, g: 0.02, b: 0.02, a: 1}
    shake: 0
  - speaker: ""
    text: "RimbaChromia\nGIMERSIA 2026\n\nThank you for playing!"
    cg: {fileID: 0}
    backgroundColor: {r: 0.02, g: 0.02, b: 0.02, a: 1}
    shake: 0
