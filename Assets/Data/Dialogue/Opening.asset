%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d28e610806839a3308baf4b0124d8251, type: 3}
  m_Name: Opening
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: ""
    text: "Aku bermimpi berada di sebuah hutan yang begitu hidup..."
    cg: {fileID: 0}
    backgroundColor: {r: 0.3, g: 0.5, b: 0.32, a: 1}
    shake: 0
  - speaker: ""
    text: "Pepohonan menjulang tinggi, cahaya menembus dedaunan, dan hewan-hewan berlarian dengan riang."
    cg: {fileID: 0}
    backgroundColor: {r: 0.3, g: 0.5, b: 0.32, a: 1}
    shake: 0
  - speaker: ""
    text: "DUAARR!!"
    cg: {fileID: 0}
    backgroundColor: {r: 0.02, g: 0.02, b: 0.02, a: 1}
    shake: 1
  - speaker: "Taduh"
    text: "Bangunlah... mereka datang."
    cg: {fileID: 0}
    backgroundColor: {r: 0.06, g: 0.1, b: 0.08, a: 1}
    shake: 0
  - speaker: "Kamu"
    text: "Apa...?"
    cg: {fileID: 0}
    backgroundColor: {r: 0.06, g: 0.1, b: 0.08, a: 1}
    shake: 0
  - speaker: "Taduh"
    text: "Kita harus bersiap secepat mungkin. Dengarkan aku baik-baik."
    cg: {fileID: 0}
    backgroundColor: {r: 0.07, g: 0.17, b: 0.15, a: 1}
    shake: 0
  - speaker: "Taduh"
    text: "Aku Taduh, roh penjaga hutan ini. Monster api buatan manusia sedang menuju The Wall, jantung hutan kami."
    cg: {fileID: 0}
    backgroundColor: {r: 0.07, g: 0.17, b: 0.15, a: 1}
    shake: 0
  - speaker: "Taduh"
    text: "Akan kupinjamkan kekuatan warna-warna hutan padamu. Ayo, akan kutunjukkan caranya."
    cg: {fileID: 0}
    backgroundColor: {r: 0.07, g: 0.17, b: 0.15, a: 1}
    shake: 0
