%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d28e610806839a3308baf4b0124d8251, type: 3}
  m_Name: Opening
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: ""
    text: "I was dreaming of a forest so full of life..."
    cg: {fileID: 21300000, guid: 21e01338564ef720a71d10bc1951cb74, type: 3}
    backgroundColor: {r: 0.3, g: 0.5, b: 0.32, a: 1}
    shake: 0
  - speaker: ""
    text: "Towering trees, sunlight pouring through the leaves, and animals running around happily."
    cg: {fileID: 21300000, guid: 21e01338564ef720a71d10bc1951cb74, type: 3}
    backgroundColor: {r: 0.3, g: 0.5, b: 0.32, a: 1}
    shake: 0
  - speaker: ""
    text: "BOOM!!"
    cg: {fileID: 0}
    backgroundColor: {r: 0.02, g: 0.02, b: 0.02, a: 1}
    shake: 1
  - speaker: "Taduh"
    text: "Please wake up... they are coming."
    cg: {fileID: 0}
    backgroundColor: {r: 0.06, g: 0.1, b: 0.08, a: 1}
    shake: 0
  - speaker: "You"
    text: "What...?"
    cg: {fileID: 0}
    backgroundColor: {r: 0.06, g: 0.1, b: 0.08, a: 1}
    shake: 0
  - speaker: "Taduh"
    text: "We need to prepare as quickly as possible. Listen to me carefully."
    cg: {fileID: 0}
    backgroundColor: {r: 0.07, g: 0.17, b: 0.15, a: 1}
    shake: 0
  - speaker: "Taduh"
    text: "I am Taduh, the spirit of this forest. Fire monsters made by humans are marching toward The Wall, the heart of our forest."
    cg: {fileID: 0}
    backgroundColor: {r: 0.07, g: 0.17, b: 0.15, a: 1}
    shake: 0
  - speaker: "Taduh"
    text: "I will lend you the power of the forest's colors. Come, let me show you how."
    cg: {fileID: 0}
    backgroundColor: {r: 0.07, g: 0.17, b: 0.15, a: 1}
    shake: 0
